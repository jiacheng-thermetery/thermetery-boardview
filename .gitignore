# Private / sensitive content — never commit
private/
notes/
rules-private/
*.private.yaml
*.private.yml
*.private.json
*.notes
*.notes.md
*.confidential*
*confidential*

# NDA materials
nda/
*.nda.*

# Boardviews and schematics — these are often redistributed under murky
# licensing. Don't commit them by default; explicitly add anything you
# want tracked.
*.cad
*.brd
*.brd2
*.bv
*.bdv
*.fz
*.pcb
*.tvw
*.cst
*.brdview
*.pdf
schematics/
boardviews/

# Derived-from-boardview artifacts. These are generated locally from the
# proprietary source files above and contain the same content in cleartext
# or partially-decoded form — same NDA / license posture as the source.
# *.tvw.topocache.pkl  — TVW trace topology graph (segments + polylines),
#                        pickled per board, 13-15 MB each. Decoded
#                        proprietary content.
# *.fz.cache           — Decrypted FZ plaintext, sits next to the .fz
#                        after a successful RC6 decode. This is exactly
#                        the IP/leakage hazard the encryption was meant
#                        to prevent.
# *.obdlocal,
# *.sqlite3            — OpenBoardView local-tracking files; contain
#                        per-board annotations and state derived from
#                        proprietary boardviews.
*.tvw.topocache.pkl
*.fz.cache
*.obdlocal
*.sqlite3

# Common secret-leak patterns
.env
.env.*
*.pem
*.key
secrets/

# Historical snapshots and sister repos — tracked elsewhere or not for
# public distribution.
milestones/
boardviewer/

# Scratch / one-off / backup files left around the working tree.
*.bak
tvw_seg_*.txt
_subagent_legacy.txt
_extract_subagent.py

# Editor / OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Native extensions (compiled DLLs / shared libraries)
*.dll
*.dylib
*.so

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# User config (last-used dir + recent file list)
.boardviewer.json

# Android exporter scratch dir — local sample JSON for the JS renderer
# dev harness (exported from proprietary boardviews; never commit).
_android_samples/

# Renderer verification screenshots (local emulator/headless captures).
_renderer_shots/

# Android: the prebuilt native libs ARE committed — cross-compiled .so for
# the two shipped ABIs (arm64-v8a, x86_64), 16 KB-aligned. Exempt them from
# the global *.so ignore above so a fresh `git add` keeps tracking them.
!android/app/src/main/jniLibs/**/*.so
